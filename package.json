{
  "name": "dumb-broker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dumb Broker - a dumb fetch pipe. Fetches a URL it is told to fetch and returns the raw result. Nothing else.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node scripts/check-env.mjs && npm run build && node .output/server/index.mjs",
    "serve": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "nitro": "^3.0.261103-rc",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
